HERMES_API_KEY=
OPENROUTER_API_KEY=
# Supervisor analysis stays on the recorded provider until a bounded OpenRouter test is approved.
# Proposed model: openai/gpt-4.1-mini
# The key is read only from the server environment. Do not put it in this file or in a request.
# CELLERTZ_CONVERSATION_PROVIDER=openrouter
# CELLERTZ_CONVERSATION_MODEL=openai/gpt-4.1-mini
CELLERTZ_SUPERVISOR_MAX_CALLS=8
CELLERTZ_SUPERVISOR_MAX_OUTPUT_TOKENS=400
CELLERTZ_SUPERVISOR_TOKEN_BUDGET=2000
CELLERTZ_SUPERVISOR_CALL_TIMEOUT_SECONDS=30
