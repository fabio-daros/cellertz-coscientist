# Applied when the frontend is built (`npm run build`) and when the Vite
# dev server starts. The browser does not read this value from the host
# environment at page load. Changing it requires building the frontend again.
#
# Leave it empty when this installation has no demonstration journey.
# The application does not substitute a built-in journey id.
#
# Bioturing PDL1 pilot:
# VITE_CELLERTZ_DEMONSTRATION_JOURNEY_ID=journey_ea6cc3b62cff41558d5a4a75c191a1bd
VITE_CELLERTZ_DEMONSTRATION_JOURNEY_ID=
