# Applied when the frontend is built (`npm run build`) and when the Vite
# dev server starts. The browser does not read this value from the host
# environment at page load. Changing it requires building the frontend again.
#
# Leave it empty when this installation has no demonstration journey.
# The application does not substitute a built-in journey id.
#
# Bioturing PDL1 pilot:
# VITE_CELLERTZ_DEMONSTRATION_JOURNEY_ID=journey_ea6cc3b62cff41558d5a4a75c191a1bd
VITE_CELLERTZ_DEMONSTRATION_JOURNEY_ID=

# Address of the Django admin, which runs as its own service on its own port.
# Applied at build time, like the value above.
#
# Leave it empty when this installation does not offer the link. The header
# then shows no Admin entry, and no built-in address is substituted. Keep it
# empty for a deployment where the admin is not meant to be advertised.
#
# Workstation reached over Tailscale:
# VITE_CELLERTZ_DJANGO_ADMIN_URL=http://100.90.242.48:8000/admin/
# Workstation reached through an editor port forward:
# VITE_CELLERTZ_DJANGO_ADMIN_URL=http://127.0.0.1:8000/admin/
VITE_CELLERTZ_DJANGO_ADMIN_URL=
